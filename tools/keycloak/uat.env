# Source in each UAT terminal (bash):  . tools/keycloak/uat.env
# Everything the SPEC-006 UAT plan refers to, for the local Keycloak in this folder.

export LDE_DATABASE_URL="postgres://lde:lde@localhost:5432/lde_uat006?sslmode=disable"
export LAB=http://localhost:8080
export T1=00000000-0000-4000-8000-0000000000a1      # the production tenant
export T2=00000000-0000-4000-8000-0000000000b2      # mallory's tenant
export ISSUER=http://localhost:8081/realms/lab

# Keycloak user ids, which are the tokens' "sub" claims (fixed in lab-realm.json).
export SUB_ALICE=11111111-1111-4111-8111-000000000001
export SUB_BOB=11111111-1111-4111-8111-000000000002
export SUB_CAROL=11111111-1111-4111-8111-000000000003
export SUB_DAVE=11111111-1111-4111-8111-000000000004
export SUB_MALLORY=11111111-1111-4111-8111-000000000005
export SUB_BOT=11111111-1111-4111-8111-000000000006

# tok alice|bob|carol|dave|mallory|bot  -> prints a fresh access token (they last 15 minutes)
tok() {
  if [ "$1" = bot ]; then
    set -- -d grant_type=client_credentials -d client_id=labrat-bot -d client_secret=bot-secret
  else
    set -- -d grant_type=password -d client_id=labrat-uat -d "username=$1" -d password=labrat -d scope=openid
  fi
  curl -s "$@" "$ISSUER/protocol/openid-connect/token" | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p'
}

# tokens  -> exports TOKEN_ALICE ... TOKEN_BOT. Run it again whenever you get 401 for an expired token.
tokens() {
  for u in alice bob carol dave mallory bot; do
    t=$(tok "$u")
    [ -n "$t" ] || { echo "no token for $u: is Keycloak up? (docker compose --profile idp up -d keycloak)" >&2; return 1; }
    export "TOKEN_$(echo "$u" | tr a-z A-Z)=$t"
  done
  echo "tokens exported: TOKEN_ALICE TOKEN_BOB TOKEN_CAROL TOKEN_DAVE TOKEN_MALLORY TOKEN_BOT"
}

# Server mode. Sourcing this file starts in dev mode (Part A), clearing any prod
# settings left in the shell. prod_env switches to Part B; dev_env switches back.
dev_env() {
  unset LDE_ENV LDE_OIDC_ISSUER LDE_OIDC_AUDIENCE LDE_OIDC_UI_CLIENT_ID LDE_OIDC_UI_SCOPES LDE_OIDC_TENANT_CLAIM
  echo "dev mode (Part A); now: go run ./cmd/server   (its first log line must say \"env\":\"dev\")"
}
prod_env() {
  # Always the local Keycloak, even if ISSUER was overwritten (e.g. by the plan's "another IdP" block).
  export ISSUER=http://localhost:8081/realms/lab
  export LDE_ENV=prod LDE_OIDC_ISSUER=$ISSUER LDE_OIDC_AUDIENCE=labrat LDE_OIDC_UI_CLIENT_ID=labrat-ui
  echo "prod mode (Part B); now: go run ./cmd/server   (its first log line must say \"env\":\"prod\")"
}
dev_env
